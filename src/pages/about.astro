---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAMinimal from "../components/CTAMinimal.astro";
---

<BaseLayout title="About Me" description="Learn more about Julie Pham">
  <div class="about-page">
    <div class="container">
      <!-- Intro Section -->
      <section class="intro-section">
        <div class="intro-content">
          <div class="avatar-wrapper">
            <img
              src="/images/avatar/ava2.jpg"
              alt="Julie Pham"
              class="avatar"
            />
          </div>
          <div class="intro-text">
            <h1 class="page-title">A little bit about me 👋</h1>
          </div>
        </div>
      </section>

      <section class="about-section">
        <p class="about-text">
          By day, I’m a Product Manager who likes turning ideas into actual
          things.
        </p>
        <p class="about-text">
          I spent 3 years managing cash and liquidity products for large
          corporations at Techcombank, followed by 4 years building digital
          lending products from 0 → 1 at Grab. I’ve also led cross-functional
          teams across business and security projects.
        </p>
        <p class="about-text">
          And somewhere along the way, I fell down the AI rabbit hole 🤖. These
          days, I’m working with a financial institution on AI application
          security.
        </p>
      </section>

      <section class="list-section">
        <h2 class="section-heading">Things I genuinely enjoy:</h2>
        <ul class="about-list">
          <li>
            Turning ideas into things (and then immediately thinking about how
            to make them better)
          </li>
          <li>Being curious and learning things</li>
          <li>
            Thinking about how we can use AI in a thoughtful and responsible way
          </li>
        </ul>
      </section>

      <section class="list-section">
        <h2 class="section-heading">
          If I had to pick 3 things I’m probably best at:
        </h2>
        <ul class="about-list">
          <li>Finding ways to improve things</li>
          <li>Bringing some clarity when everything feels messy</li>
          <li>
            Being annoyingly disciplined when I’ve decided to do something
          </li>
        </ul>
      </section>

      <section class="list-section">
        <h2 class="section-heading">A few random facts:</h2>
        <ul class="about-list">
          <li>
            I’ve lived in 2 countries — Vietnam and Belgium — across 4 cities,
            and travelled to around 8 countries so far. Hopefully many more to
            come!
          </li>
          <li>
            Outside of work, you’ll probably find me playing badminton or
            hiking. Am I good at either? Not really 😆. Do I still enjoy them?
            Very much.
          </li>
        </ul>
      </section>

      <!-- Connect Section -->
      <CTAMinimal />
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: var(--spacing-3xl) 0;
  }

  /* Intro Section */
  .intro-section {
    margin-bottom: var(--spacing-xl);
  }

  .intro-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xl);
  }

  .intro-text {
    flex: 1;
  }

  .avatar-wrapper {
    flex-shrink: 0;
  }

  .avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 0px solid var(--color-accent);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: 700;
    margin-bottom: var(--spacing-md);
  }

  .lead {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  /* Section Styles */
  .about-section,
  .list-section {
    margin-bottom: var(--spacing-lg);
  }

  .about-text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .section-heading {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text);
  }

  .about-list {
    list-style: disc;
    padding-left: var(--spacing-lg);
    margin: 0;
  }

  .about-list li {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-xs);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .intro-content {
      flex-direction: column;
      text-align: center;
    }

    .avatar {
      width: 150px;
      height: 150px;
    }
  }
</style>
