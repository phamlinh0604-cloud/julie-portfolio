---
// CTA + Social + Footer — Nico-inspired minimal bottom section
const currentYear = new Date().getFullYear();
---

<section class="cta-minimal">
  <div class="container-minimal">

    <!-- Small intro line -->
    <p class="cta-intro">Thanks for reading! Want to continue the conversation?</p>

    <!-- Big serif "Get in touch →" — links to email -->
    <a
      href="mailto:juliepham.biz@gmail.com"
      class="cta-link-primary"
    >
      <span class="cta-text">Get in touch</span>
      <span class="cta-arrow">→</span>
    </a>

    <!-- Social icons: LinkedIn + GitHub -->
    <div class="social-icons">

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/linh-pham-khanh-vietnam/"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="LinkedIn"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/phamlinh0604-cloud"
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
        aria-label="GitHub"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>

    </div>

  </div>
</section>

<style>
  /* ─── Outer section ──────────────────────────────────────────────── */
  .cta-minimal {
    padding: 100px 0 80px;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .container-minimal {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  /* ─── Intro line ─────────────────────────────────────────────────── */
  .cta-intro {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-muted);
    margin: 0 0 28px 0;
    letter-spacing: 0.01em;
  }

  /* ─── Big CTA link ───────────────────────────────────────────────── */
  .cta-link-primary {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: #1a1a1a;
    padding-bottom: 6px;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 52px;
    transition: opacity 0.25s ease;
  }

  .cta-link-primary:hover {
    opacity: 0.5;
    color: #1a1a1a;
  }

  .cta-link-primary:hover .cta-arrow {
    transform: translateX(6px);
  }

  .cta-text {
    font-family: 'Cormorant Garamond', 'Cochin', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .cta-arrow {
    font-family: 'Cormorant Garamond', 'Cochin', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 300;
    line-height: 1.1;
    transition: transform 0.25s ease;
    display: inline-block;
  }

  /* ─── Social Icons ───────────────────────────────────────────────── */
  .social-icons {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 52px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .social-icon:hover {
    opacity: 0.4;
    color: #1a1a1a;
  }

  /* ─── Copyright line ─────────────────────────────────────────────── */
  .footer-copy {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
    letter-spacing: 0.01em;
  }

  /* ─── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .cta-minimal {
      padding: 72px 0 56px;
    }
    .container-minimal {
      padding: 0 24px;
    }
  }
</style>