---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home',     href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog',     href: '/blog' },
  { label: 'About',   href: '/about' },
];
---

<header class="header">
  <nav class="nav">
    <!-- Wordmark -->
    <a href="/" class="logo">Julie Pham</a>

    <!-- Desktop Nav -->
    <ul class="nav-links" id="nav-links">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button class="mobile-toggle" aria-label="Toggle menu" id="mobile-toggle">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const navLinks = document.getElementById('nav-links');
  if (toggle && navLinks) {
    toggle.addEventListener('click', () => {
      navLinks.classList.toggle('open');
      toggle.classList.toggle('open');
    });
  }
</script>

<style>
  /* ─── Header Shell ───────────────────────────────────────────────── */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    /* Fully transparent — no background, no border, like Nico */
    background: transparent;
    padding: 32px 0;
    transition: background 0.3s ease, padding 0.3s ease;
  }

  /* Subtle white wash on scroll so links stay readable */
  .header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 20px 0;
  }

  /* ─── Nav Row ────────────────────────────────────────────────────── */
  .nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ─── Wordmark ───────────────────────────────────────────────────── */
  .logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.5;
  }

  /* ─── Nav Links ──────────────────────────────────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    font-size: 0.8125rem;             /* 13px — same tight size as Nico */
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.5;
    border-bottom-color: transparent;
  }

  /* Active state: underline only, no colour change */
  .nav-link.active {
    border-bottom: 1px solid #1a1a1a;
  }

  /* ─── Mobile Toggle ──────────────────────────────────────────────── */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .bar {
    display: block;
    width: 22px;
    height: 1px;
    background: #1a1a1a;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  /* Animate to × on open */
  .mobile-toggle.open .bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .mobile-toggle.open .bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ─── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .nav {
      padding: 0 24px;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #ffffff;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 36px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .nav-links.open {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-link {
      font-size: 1.25rem;
      letter-spacing: 0.08em;
    }
  }
</style>

<!-- Scroll listener: add .scrolled class to header -->
<script>
  const header = document.querySelector('.header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  }
</script>