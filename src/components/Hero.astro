---
// Hero component for homepage
---

<section class="hero-editorial">
  <div class="container-editorial">
    <div class="hero-split">

      <!-- Left: Circular Avatar -->
      <div class="hero-avatar-col">
        <div class="avatar-ring">
          <img
            src={`${import.meta.env.BASE_URL}images/avatar/ava.jpg`}
            alt="Julie Pham"
            class="avatar-img"
          />
        </div>
      </div>

      <!-- Right: Intro Text -->
      <div class="hero-text-col">
        <h1 class="hero-intro">
          Hi, I'm <span class="underline-accent">Julie Pham</span> 
        </h1>

        <p class="hero-body">
          I am a product manager enthusiastic about turning AI capabilities into scalable, business-driven solutions.
        </p>

        <p class="hero-closing">
          I've led cross-functional teams to build <span class="underline-accent">shop-now-pay-later</span> product for small business owners and <span class="underline-accent">cash loan</span> products for individuals and small business owners from 0 to 1.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-editorial {
    background: #ffffff;
    padding: 120px 0 100px;
  }

  .container-editorial {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .hero-split {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 72px;
    align-items: center;
    animation: fadeInUp 0.9s ease-out both;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-avatar-col {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-ring {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    overflow: hidden;
    background: #f2f0eb;
    flex-shrink: 0;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: filter 0.4s ease;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
  }

  .hero-intro {
    font-family: 'Cormorant Garamond', 'Cochin', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.625rem);
    font-weight: 400;
    line-height: 1.35;
    color: #1a1a1a;
    margin: 0 0 2rem 0;
    letter-spacing: -0.025em;
  }

  .hero-body {
    font-family: 'Cormorant Garamond', 'Cochin', Georgia, serif;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.85;
    color: #1a1a1a;
    margin: 0 0 1.75rem 0;
    letter-spacing: -0.01em;
  }

  .hero-closing {
    font-family: 'Cormorant Garamond', 'Cochin', Georgia, serif;
    font-size: clamp(1rem, 1.75vw, 1.3rem);
    font-weight: 400;
    line-height: 1.75;
    color: #555;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .underline-accent {
    text-decoration: underline;
    text-decoration-color: #1a1a1a;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 400;
    transition: text-decoration-color 0.2s ease;
  }

  .underline-accent:hover {
    text-decoration-color: transparent;
  }

  @media (max-width: 900px) {
    .hero-split {
      grid-template-columns: 220px 1fr;
      gap: 48px;
    }
    .avatar-ring { width: 200px; height: 200px; }
  }

  @media (max-width: 640px) {
    .hero-editorial { padding: 72px 0 56px; }
    .container-editorial { padding: 0 24px; }
    .hero-split {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .hero-avatar-col { justify-content: center; }
    .avatar-ring { width: 160px; height: 160px; }
    .hero-intro { font-size: 1.75rem; margin-bottom: 1.5rem; }
    .hero-body { font-size: 1.125rem; }
    .hero-closing { font-size: 1rem; }
  }
</style>