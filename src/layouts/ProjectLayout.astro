---
import BaseLayout from './BaseLayout.astro';

const { frontmatter, headings } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
>
  <article class="project-page">

    <!-- ── Narrow header column ───────────────────────────── -->
    <header class="project-header">
      <div class="project-layout-container">
        <!-- Empty placeholder to align header with content -->
        <div class="project-sidebar-placeholder">
          <a href="/projects" class="back-link">← Projects</a>
        </div>
        
        <div class="header-inner">
          <!-- Meta line: role, company, year -->
          {frontmatter.role && (
            <p class="project-meta">
              <strong>{frontmatter.role}</strong>
              {frontmatter.company && `, ${frontmatter.company}`}
              {frontmatter.year && `, ${frontmatter.year}`}
            </p>
          )}

          <h1 class="project-title">{frontmatter.title}</h1>
          <p class="project-lead">{frontmatter.description}</p>

          <!-- ── Hero image ─────────────────────────────────────── -->
          {frontmatter.image && (
            <div class="project-hero">
              <img 
                src={`/${frontmatter.image}`} 
                alt={frontmatter.title} 
              />
            </div>
          )}

          <!-- Demo / Repo links -->
          {(frontmatter.demoURL || frontmatter.repoURL) && (
            <div class="project-links">
              {frontmatter.demoURL && (
                <a href={frontmatter.demoURL} target="_blank" rel="noopener noreferrer" class="project-cta">
                  View live app →
                </a>
              )}
              {frontmatter.repoURL && (
                <a href={frontmatter.repoURL} target="_blank" rel="noopener noreferrer" class="project-cta">
                  View repository →
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- ── Body content (from markdown) ──────────────────── -->
    <div class="project-body">
      <div class="project-layout-container">
        
        <!-- Sidebar TOC -->
        <aside class="project-sidebar">
          {headings && headings.length > 0 && (
            <nav class="toc">
              <h4 class="toc-title">On this page</h4>
              <ul class="toc-list" id="toc-list">
                {headings.filter((h: any) => h.depth === 2).map((heading: any) => (
                  <li class={`toc-item depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </aside>

        <div class="project-content">
          <slot />
        </div>
      </div>
    </div>

    <!-- ── Footer nav ─────────────────────────────────────── -->
    <footer class="project-footer">
      <div class="project-layout-container">
        <div class="project-sidebar-placeholder"></div>
        <div class="footer-inner">
          <a href="/projects" class="back-link-footer">← Back to all projects</a>
        </div>
      </div>
    </footer>

  </article>

<script>
  // Active TOC highlight script
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        const tocLink = document.querySelector(`.toc-link[href="#${id}"]`);
        
        if (entry.isIntersecting) {
          document.querySelectorAll('.toc-link').forEach(link => link.classList.remove('active'));
          if (tocLink) tocLink.classList.add('active');
        }
      });
    }, {
      rootMargin: '0px 0px -80% 0px' // Adjust to trigger when heading is near top
    });

    // Observe all h2 and h3 elements inside .project-content
    document.querySelectorAll('.project-content h2, .project-content h3').forEach((section) => {
      observer.observe(section);
    });
  });
</script>
</BaseLayout>

<style>
  /* ─── Page shell ─────────────────────────────────────────── */
  .project-page {
    padding-top: 0;
  }

  /* ─── Header ─────────────────────────────────────────────── */
  .project-header {
    padding: 120px 0 80px;
    background: #ffffff;
  }

  .project-layout-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    justify-content: space-between;
    gap: 80px;
    align-items: flex-start;
  }

  .project-sidebar-placeholder,
  .project-sidebar {
    width: 250px;
    flex-shrink: 0;
  }

  .project-sidebar {
    position: -webkit-sticky;
    position: sticky;
    top: 120px; /* Pushed down to clear the fixed header */
    max-height: calc(100vh - 140px);
    overflow-y: auto;
  }

  /* Hide scrollbar for cleaner look */
  .project-sidebar::-webkit-scrollbar {
    display: none;
  }
  .project-sidebar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .header-inner {
    flex: 1;
    max-width: 100%;
    min-width: 0;
    width: 100%;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 1;
  }

  /* Role / meta */
  .project-meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #1a1a1a;
    margin: 0 0 24px 0;
    letter-spacing: 0.01em;
  }

  .project-meta strong {
    font-weight: 600;
  }

  /* Title */
  .project-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    margin: 0 0 28px 0;
  }

  /* Lead description */
  .project-lead {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #555;
    margin: 0 0 36px 0;
  }

  /* CTA links */
  .project-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-cta {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
    display: inline-block;
  }

  .project-cta:hover {
    opacity: 0.5;
    color: #1a1a1a;
  }

  /* ─── Hero image ─────────────────────────────────────────── */
  .project-hero {
    margin: 0 0 80px;
  }

  .project-hero img {
    width: 100%;
    max-width: 600px;
    max-height: 420px;
    object-fit: cover;
    object-position: center top;
    display: block;
    margin-left: 0;
  }

  /* ─── Body content ───────────────────────────────────────── */
  .project-body {
    padding: 0 0 var(--spacing-3xl);
  }

  .project-content {
    flex: 1;
    max-width: 100%;
    min-width: 0;
    width: 100%;
  }

  /* ── TOC Styles ────────────── */
  .toc {
    padding-top: 10px;
  }

  .toc-title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 0 0 1rem 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc-item {
    margin: 0;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
  }

  .toc-link {
    display: block;
    padding: 0.5rem 0 0.5rem 1rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    color: #555;
    text-decoration: none;
    line-height: 1.4;
    text-align: left;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
    margin-left: -1px;
  }

  .toc-link:hover,
  .toc-link.active {
    color: #1a1a1a;
    border-left-color: #1a1a1a;
    font-weight: 500;
  }

  /* ── Markdown content styles ────────────── */

  .project-content :global(h2) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 3rem 0 1.25rem;
    line-height: 1.2;
    font-variant-numeric: lining-nums; 
    scroll-margin-top: 140px;
  }

  .project-content :global(h3) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 510;
    letter-spacing: -0.015em;
    color: #1a1a1a;
    margin: 2.5rem 0 1rem;
    line-height: 1.25;
    font-variant-numeric: lining-nums; 
    scroll-margin-top: 140px;
  }

  .project-content :global(h4) {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 2rem 0 0.75rem;
  }

  .project-content :global(p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.85;
    color: #444;
    margin: 0 0 1.5rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.5rem;
  }

  .project-content :global(li) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 0.5rem;
  }

  .project-content :global(strong) {
    color: #1a1a1a;
    font-weight: 600;
  }

  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  /* Blockquote — used for the system prompt excerpt */
  .project-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    border-left: 2px solid #1a1a1a;
    background: #fafafa;
  }

  .project-content :global(blockquote p) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.75;
    color: #1a1a1a;
    font-style: italic;
    margin: 0;
  }

  /* Table — for the prototype vs production comparison */
  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    display: block;
    overflow-x: auto;
  }

  .project-content :global(th) {
    text-align: left;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1a1a1a;
    border-bottom: 2px solid #1a1a1a;
    padding: 0 16px 12px 0;
  }

  .project-content :global(td) {
    vertical-align: top;
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--color-border);
    color: #444;
    line-height: 1.6;
  }

  /* Inline code */
  .project-content :global(pre) {
  background: #f4f5f6 !important;
  border: 1px solid #e2e8f0 !important; 
  border-radius: 8px !important; 
  padding: 1.5rem 2rem !important;
  margin: 2rem 0 !important;
  overflow-x: auto !important;
}

.project-content :global(pre code) {
  background: none;
  padding: 0;
  font-size: 0.875rem;
  line-height: 1.8;
  color: #1a1a1a;
  letter-spacing: 0.01em;
}
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: #f4f4f2;
    padding: 2px 6px;
    letter-spacing: 0;
    border-radius: 3px;
  }

  /* Images inside content */
  .project-content :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0.3rem 0 1rem;
  }

  /* Links inside content */
  .project-content :global(a) {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .project-content :global(a:hover) {
    opacity: 0.5;
  }

  /* ─── Footer nav ─────────────────────────────────────────── */
  .project-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-xl) 0 var(--spacing-3xl);
  }

  .footer-inner {
    flex: 1;
    max-width: 100%;
    min-width: 0;
    width: 100%;
  }

  .back-link-footer {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .back-link-footer:hover {
    opacity: 1;
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .project-layout-container {
      flex-direction: column;
      gap: 32px;
      align-items: stretch;
    }

    .project-sidebar-placeholder {
      display: none; /* Hide placeholder on mobile */
    }

    .project-sidebar {
      position: static;
      width: 100%;
      margin-bottom: 24px;
    }

    .back-link {
      margin-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .project-layout-container {
      padding-left: 24px;
      padding-right: 24px;
    }

    .project-header {
      padding: 80px 0 56px;
    }

    .project-hero {
      margin-bottom: 48px;
    }

    .project-content :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>