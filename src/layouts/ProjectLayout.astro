---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
>
  <article class="project-page">

    <!-- ── Narrow header column ───────────────────────────── -->
    <header class="project-header">
      <div class="header-inner">

        <a href="/projects" class="back-link">← Projects</a>

        <!-- Meta line: role, company, year -->
        {frontmatter.role && (
          <p class="project-meta">
            <strong>{frontmatter.role}</strong>
            {frontmatter.company && `, ${frontmatter.company}`}
            {frontmatter.year && `, ${frontmatter.year}`}
          </p>
        )}

        <h1 class="project-title">{frontmatter.title}</h1>
        <p class="project-lead">{frontmatter.description}</p>

        <!-- ── Hero image ─────────────────────────────────────── -->
        {frontmatter.image && (
          <div class="project-hero">
            <img 
              src={`/${frontmatter.image}`} 
              alt={frontmatter.title} 
            />
          </div>
        )}

        <!-- Demo / Repo links -->
        {(frontmatter.demoURL || frontmatter.repoURL) && (
          <div class="project-links">
            {frontmatter.demoURL && (
              <a href={frontmatter.demoURL} target="_blank" rel="noopener noreferrer" class="project-cta">
                View live app →
              </a>
            )}
            {frontmatter.repoURL && (
              <a href={frontmatter.repoURL} target="_blank" rel="noopener noreferrer" class="project-cta">
                View repository →
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <!-- ── Body content (from markdown) ──────────────────── -->
    <div class="project-body">
      <div class="project-content">
        <slot />
      </div>
    </div>

    <!-- ── Footer nav ─────────────────────────────────────── -->
    <footer class="project-footer">
      <a href="/projects" class="back-link-footer">← Back to all projects</a>
    </footer>

  </article>
</BaseLayout>

<style>
  /* ─── Page shell ─────────────────────────────────────────── */
  .project-page {
    padding-top: 0;
  }

  /* ─── Header ─────────────────────────────────────────────── */
  .project-header {
    padding: 120px 0 80px;
    background: #ffffff;
  }

  .header-inner {
    max-width: 850px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    text-decoration: none;
    margin-bottom: 40px;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 1;
  }

  /* Role / meta */
  .project-meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #1a1a1a;
    margin: 0 0 24px 0;
    letter-spacing: 0.01em;
  }

  .project-meta strong {
    font-weight: 600;
  }

  /* Title */
  .project-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    margin: 0 0 28px 0;
  }

  /* Lead description */
  .project-lead {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #555;
    margin: 0 0 36px 0;
  }

  /* CTA links */
  .project-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-cta {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
    display: inline-block;
  }

  .project-cta:hover {
    opacity: 0.5;
    color: #1a1a1a;
  }

  /* ─── Hero image ─────────────────────────────────────────── */
  .project-hero {
    max-width: 850px;
    margin: 0 auto 80px;
    padding: 0 48px;
  }

  .project-hero img {
    width: 100%;
    max-width: 600px;
    max-height: 420px;
    object-fit: cover;
    object-position: center top;
    display: block;
    margin-left: 0;
  }

  /* ─── Body content ───────────────────────────────────────── */
  .project-body {
    padding: 0 0 var(--spacing-3xl);
  }

  .project-content {
    max-width: 850px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* ── Markdown content styles ────────────── */

  .project-content :global(h2) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 3rem 0 1.25rem;
    line-height: 1.2;
    font-variant-numeric: lining-nums; 
  }

  .project-content :global(h3) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 510;
    letter-spacing: -0.015em;
    color: #1a1a1a;
    margin: 2.5rem 0 1rem;
    line-height: 1.25;
    font-variant-numeric: lining-nums; 
  }

  .project-content :global(h4) {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 2rem 0 0.75rem;
  }

  .project-content :global(p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.85;
    color: #444;
    margin: 0 0 1.5rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.5rem;
  }

  .project-content :global(li) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 0.5rem;
  }

  .project-content :global(strong) {
    color: #1a1a1a;
    font-weight: 600;
  }

  .project-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  /* Blockquote — used for the system prompt excerpt */
  .project-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem 2rem;
    border-left: 2px solid #1a1a1a;
    background: #fafafa;
  }

  .project-content :global(blockquote p) {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.75;
    color: #1a1a1a;
    font-style: italic;
    margin: 0;
  }

  /* Table — for the prototype vs production comparison */
  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }

  .project-content :global(th) {
    text-align: left;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1a1a1a;
    border-bottom: 2px solid #1a1a1a;
    padding: 0 16px 12px 0;
  }

  .project-content :global(td) {
    vertical-align: top;
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--color-border);
    color: #444;
    line-height: 1.6;
  }

  /* Inline code */
  .project-content :global(pre) {
  background: #f4f5f6 !important;
  border: 1px solid #e2e8f0 !important; 
  border-radius: 8px !important; 
  padding: 1.5rem 2rem !important;
  margin: 2rem 0 !important;
  overflow-x: auto !important;
}

.project-content :global(pre code) {
  background: none;
  padding: 0;
  font-size: 0.875rem;
  line-height: 1.8;
  color: #1a1a1a;
  letter-spacing: 0.01em;
}
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: #f4f4f2;
    padding: 2px 6px;
    letter-spacing: 0;
    border-radius: 3px;
  }

  /* Images inside content */
  .project-content :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0.3rem 0 1rem;
  }

  /* Links inside content */
  .project-content :global(a) {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .project-content :global(a:hover) {
    opacity: 0.5;
  }

  /* ─── Footer nav ─────────────────────────────────────────── */
  .project-footer {
    max-width: 850px;
    margin: 0 auto;
    padding: var(--spacing-xl) 48px var(--spacing-3xl);
    border-top: 1px solid var(--color-border);
  }

  .back-link-footer {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .back-link-footer:hover {
    opacity: 1;
  }

  /* ─── Responsive ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    .header-inner,
    .project-hero,
    .project-content,
    .project-footer {
      padding-left: 24px;
      padding-right: 24px;
    }

    .project-header {
      padding: 80px 0 56px;
    }

    .project-hero {
      margin-bottom: 48px;
    }

    .project-content :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
</style>